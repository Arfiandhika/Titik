{
  "name": "titik",
  "version": "1.0.0",
  "private": true,
  "description": "Titik - civic infrastructure reporting for the Klang Valley (HCI assignment, Group 39)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "phone": "npm run build && node server/phone.js"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.2",
    "vite": "^5.4.21"
  },
  "main": "server/index.js",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@vis.gl/react-google-maps": "^1.10.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.68.0",
    "multer": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "supercluster": "^8.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.21.5": true
  }
}
