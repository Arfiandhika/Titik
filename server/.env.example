# Copy to server/.env and fill in.
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the AI category suggestion on the New report page (NFR6: the app works without it).
ANTHROPIC_API_KEY=

# Code council staff enter when signing up as an official.
OFFICIAL_CODE=TITIK-STAFF-2026

# Number of "Hoax" votes (that also outnumber "Me too") before a report is flagged for staff.
HOAX_FLAG_THRESHOLD=3

# Set to production to hide the dev verification code in API responses.
NODE_ENV=development
